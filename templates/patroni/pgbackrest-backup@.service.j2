[Unit]
Description=pgBackRest %i backup of all Citus groups (coord, worker1, worker2)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=:/bin/bash -c 'rc=0; for g in worker1 worker2 coord; do "$1" backup "$g" "$2" || rc=1; done; exit "$rc"' pgbackrest-backup "{{ patroni_pgbackrest_backup_command_path | default('/usr/local/bin/pgbackrest-citus') }}" %i
