PATRONI_HAPROXY_STATS_PORT={{ dotenv(patroni_haproxy_stats_port | default(19083)) }}
PATRONI_PGBOUNCER_BIND={{ dotenv(patroni_pgbouncer_bind | default('127.0.0.1')) }}
PATRONI_PGBOUNCER_PORT={{ dotenv(patroni_pgbouncer_port | default(26432)) }}
