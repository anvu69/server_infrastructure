# Managed by Ansible (install-patroni.yml)
{% macro dotenv(value) -%}
{% set value = value | string -%}
{# Compose single quotes cannot represent every backslash sequence. #}
{%- if '\\' in value or '\r' in value -%}
"{{ value | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '$$') | replace('\r', '\\r') | replace('\n', '\\n') }}"
{%- else -%}
'{{ value | replace("'", "\\'") }}'
{%- endif -%}
{%- endmacro -%}
PATRONI_RESTAPI_USERNAME={{ dotenv(patroni_restapi_username | default('admin')) }}
PATRONI_RESTAPI_PASSWORD={{ dotenv(patroni_restapi_password) }}
PATRONI_SUPERUSER_USERNAME={{ dotenv(patroni_superuser_username | default('postgres')) }}
PATRONI_SUPERUSER_PASSWORD={{ dotenv(patroni_superuser_password) }}
PATRONI_REPLICATION_USERNAME={{ dotenv(patroni_replication_username | default('replicator')) }}
PATRONI_REPLICATION_PASSWORD={{ dotenv(patroni_replication_password) }}
PATRONI_REWIND_USERNAME={{ dotenv(patroni_rewind_username | default('rewind_user')) }}
PATRONI_REWIND_PASSWORD={{ dotenv(patroni_rewind_password) }}
PATRONI_SCOPE={{ dotenv(patroni_scope | default('demo')) }}
PATRONI_NAMESPACE={{ dotenv(patroni_namespace | default('/service')) }}
PATRONI_CITUS_DATABASE={{ dotenv(patroni_citus_database | default('citus')) }}
PATRONI_ETCD_INITIAL_CLUSTER_TOKEN={{ dotenv(patroni_etcd_initial_cluster_token | default('citus-cluster')) }}
PATRONI_DATA_DIR={{ dotenv(patroni_data_dir) }}
PATRONI_ETCD_DATA_DIR={{ dotenv(patroni_etcd_data_dir) }}
PATRONI_SSL_DIR={{ dotenv(patroni_ssl_dir_effective) }}
PATRONI_HAPROXY_TEMPLATE_DIR={{ dotenv(patroni_haproxy_template_dir_effective) }}
PATRONI_DOCKER_NETWORK={{ dotenv(patroni_docker_network | default('patroni_citus')) }}
PATRONI_PGBACKREST_CONFIG_DIR={{ dotenv(patroni_pgbackrest_config_dir_effective) }}
PATRONI_PGBACKREST_LOG_DIR={{ dotenv(patroni_pgbackrest_log_dir_effective) }}
PATRONI_PGBOUNCER_CONFIG_DIR={{ dotenv(patroni_pgbouncer_config_dir_effective) }}
PATRONI_IMAGE={{ dotenv(patroni_image | default('anvu69/patroni-citus:4.1.3-pgbr')) }}
