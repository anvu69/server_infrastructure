[databases]
* = host={{ patroni_pgbouncer_server_host | default('haproxy') }} port={{ patroni_pgbouncer_server_port | default(5000) }}

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 5432
unix_socket_dir =
auth_type = {{ patroni_pgbouncer_auth_type | default('scram-sha-256') }}
auth_file = /etc/pgbouncer/userlist.txt
pool_mode = {{ patroni_pgbouncer_pool_mode | default('session') }}
max_client_conn = {{ patroni_pgbouncer_max_client_conn | default(1000) }}
default_pool_size = {{ patroni_pgbouncer_default_pool_size | default(80) }}
reserve_pool_size = {{ patroni_pgbouncer_reserve_pool_size | default(20) }}
ignore_startup_parameters = {{ patroni_pgbouncer_ignore_startup_parameters | default('extra_float_digits,options') }}
server_tls_sslmode = {{ patroni_pgbouncer_server_tls_sslmode | default('verify-ca') }}
server_tls_ca_file = /etc/postgresql/certs/ca.crt
{% if patroni_pgbouncer_client_tls_sslmode | default('') != '' -%}
client_tls_sslmode = {{ patroni_pgbouncer_client_tls_sslmode }}
client_tls_key_file = /etc/pgbouncer/tls/server.key
client_tls_cert_file = /etc/postgresql/certs/server.crt
client_tls_ca_file = /etc/postgresql/certs/ca.crt
{% endif -%}
{% if patroni_pgbouncer_log_connections is defined %}
log_connections = {{ patroni_pgbouncer_log_connections | int }}
{% endif %}
{% if patroni_pgbouncer_log_disconnections is defined %}
log_disconnections = {{ patroni_pgbouncer_log_disconnections | int }}
{% endif %}
{% if patroni_pgbouncer_log_pooler_errors is defined %}
log_pooler_errors = {{ patroni_pgbouncer_log_pooler_errors | int }}
{% endif %}
{% if patroni_pgbouncer_stats_period is defined %}
stats_period = {{ patroni_pgbouncer_stats_period | int }}
{% endif %}
admin_users = {{ patroni_pgbouncer_admin_users | default(patroni_pgbouncer_db_user | default(patroni_superuser_username | default('postgres'))) }}
stats_users = {{ patroni_pgbouncer_stats_users | default(patroni_pgbouncer_db_user | default(patroni_superuser_username | default('postgres'))) }}
{%- if patroni_pgbouncer_users | default({}) %}{{ '\n\n' -}}
[users]
{% for user, options in patroni_pgbouncer_users | dictsort -%}
{{ user }} = {% for key, value in options | dictsort %}{{ key }}={{ value }}{{ ' ' if not loop.last else '' }}{% endfor %}{{ '\n' -}}
{% endfor -%}
{% endif -%}