# MySQL Settings
MYSQL_ROOT_PASSWORD={{ mysql_root_password }}
MYSQL_DATABASE={{ mysql_database }}
MYSQL_USER={{ mysql_user }}
MYSQL_PASSWORD={{ mysql_password }}

# MySQL Slave Settings
MYSQL_SLAVE_COUNT={{ mysql_slave_count | default(3) }}

# ProxySQL Settings
PROXYSQL_PORT={{ proxysql_port }}
PROXYSQL_ADMIN_PORT={{ proxysql_admin_port }}
PROXYSQL_ADMIN_PASSWORD={{ proxysql_admin_password }}
PROXYSQL_MONITOR_PASSWORD={{ proxysql_monitor_password }}

# Orchestrator Settings
ORCHESTRATOR_DB_PASSWORD={{ mysql_cluster_orch_db_password }}
ORCHESTRATOR_PORT={{ mysql_cluster_orch_port }}

# Docker Network
DOCKER_NETWORK={{ network }}
