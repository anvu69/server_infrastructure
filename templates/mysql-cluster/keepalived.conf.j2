vrrp_script check_proxysql {
    script "pidof proxysql"
    interval 2
    weight 2
}

vrrp_instance VI_1 {
    state MASTER
    interface eth0
    virtual_router_id {{ keepalived_router_id }}
    priority 100
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }
    virtual_ipaddress {
        {{ keepalived_virtual_ip }}
    }
    track_script {
        check_proxysql
    }
} 