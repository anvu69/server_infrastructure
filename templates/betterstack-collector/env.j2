# Managed by Ansible (install-betterstack-collector.yml)
{% macro dotenv(value) -%}
{% set value = value | string -%}
{# Compose single quotes cannot represent every backslash sequence. #}
{%- if '\\' in value or '\r' in value -%}
"{{ value | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '$$') | replace('\r', '\\r') | replace('\n', '\\n') }}"
{%- else -%}
'{{ value | replace("'", "\\'") }}'
{%- endif -%}
{%- endmacro -%}
COLLECTOR_SECRET={{ dotenv(betterstack_collector_secret) }}
BASE_URL={{ dotenv(betterstack_collector_base_url | default('https://telemetry.betterstack.com')) }}
CLUSTER_COLLECTOR={{ dotenv(betterstack_collector_cluster_collector | default(false) | string | lower) }}
ENABLE_DOCKERPROBE={{ dotenv(betterstack_collector_enable_dockerprobe | default(true) | string | lower) }}
HOSTNAME={{ dotenv(betterstack_collector_hostname | default(inventory_hostname)) }}
BETTERSTACK_COLLECTOR_TAG={{ dotenv(betterstack_collector_tag) }}
BETTERSTACK_COLLECTOR_CPUS={{ dotenv(betterstack_collector_cpus | default(1.2)) }}
BETTERSTACK_COLLECTOR_HOST_CPUS={{ dotenv(betterstack_collector_host_cpus | default(1.0)) }}
