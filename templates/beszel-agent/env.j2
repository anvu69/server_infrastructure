# Managed by Ansible (install-beszel-agent.yml)
{% macro dotenv(value) -%}
{% set value = value | string -%}
{# Compose single quotes cannot represent every backslash sequence. #}
{%- if '\\' in value or '\r' in value -%}
"{{ value | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '$$') | replace('\r', '\\r') | replace('\n', '\\n') }}"
{%- else -%}
'{{ value | replace("'", "\\'") }}'
{%- endif -%}
{%- endmacro -%}
HUB_URL={{ dotenv(beszel_agent_hub_url) }}
TOKEN={{ dotenv(beszel_agent_token) }}
KEY={{ dotenv(beszel_agent_key) }}
BESZEL_AGENT_TAG={{ dotenv(beszel_agent_tag) }}
